   "outputs": [],
   "source": [
    "# Load your annotated AnnData object\n",
    "adata = sc.read_h5ad(\"/YourProjectFolder/processed_scRNAseqDBC.h5ad\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "adata.obs['leiden_res_0.3_num'] = adata.obs['leiden_res_0.3'].astype(int)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {},
   "outputs": [],
   "source": [
    "adata.obs['cell_type'] = adata.obs['leiden_res_0.3_num'].map(cluster_to_cell_type)"
   ]
  },
