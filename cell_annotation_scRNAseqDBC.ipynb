       " 'Epithelial cell',\n",
       " 'Mesenchymal stem cell',\n",
       " 'Mesenchymal stem cell',\n",
       " 'Natural killer T (NKT) cell']"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "cell_types_with_highest_zscores"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Create a dictionary of cluster value (number) and corresponding identified cell type. We will add a column to adata with cell types for each cluster number."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   "outputs": [],
   "source": [
    "cluster_to_cell_type={0: 'Stem cell',\n",
    "                      1: 'Monocyte',\n",
    "                      2: 'Epithelial cell',\n",
    "                      3: 'Mesenchymal stem cell',\n",
    "                      4: 'Mesenchymal stem cell',\n",
    "                      5: 'Unknown'}"
   ]
  },
  {
   "cell_type": "markdown",
